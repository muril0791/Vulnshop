# ============================================================================
#  VulnShop — variaveis de ambiente (EXEMPLO)
#  AMBIENTE DE TREINO — NAO USE EM PRODUCAO, NAO EXPONHA NA INTERNET.
#
#  Uso:
#   - Com Docker: o docker-compose.yml ja define tudo; este arquivo e so
#     referencia.
#   - Rodando local (sem Docker): copie para  .env  na RAIZ do projeto
#     (o backend le  ../../.env  a partir de backend/src).
#       Windows PowerShell:  Copy-Item .env.example .env
# ============================================================================

# --- Banco de dados MySQL ---------------------------------------------------
DB_HOST=localhost        # dentro do Docker o valor correto e "db"
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=vulnshop

# --- Backend ----------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5444

# --- Frontend (Vite) --------------------------------------------------------
# URL que o React usa para chamar a API.
VITE_API_URL=http://localhost:4000
